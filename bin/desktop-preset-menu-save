#!/usr/bin/env bash
# desktop-preset-menu-save - "Save" action for the omarchy.menu Preset submenu
set -uo pipefail

name=$(omarchy menu input "Preset name") || exit 0   # cancelled
[[ -n $name ]] || exit 0

if [[ ! $name =~ ^[A-Za-z0-9_-]+$ ]]; then
  omarchy notification send "Invalid preset name" "Use letters, numbers, - and _ only" -g "" -u critical
  exit 1
fi

extra_args=()
if [[ -e ${XDG_CONFIG_HOME:-$HOME/.config}/desktop_preset/$name.preset ]]; then
  confirm=$(omarchy menu select "'$name' already exists — overwrite?" Yes No) || exit 0
  [[ $confirm == Yes ]] || exit 0
  extra_args+=(--force)
fi

out=$(desktop_preset save "$name" "${extra_args[@]}" 2>&1)
rc=$?

if (( rc == 0 )); then
  data=$(desktop_preset show "$name")
  n=$(jq '.windows | length' <<< "$data")
  missing=$(jq '[.windows[] | select(.class == "org.gnome.Nautilus" and .uri == null)] | length' <<< "$data")
  if (( missing )); then
    omarchy notification send "Saved '$name' with missing locations" "$missing Nautilus URI(s) need explicit per-instance overrides; see desktop_preset show $name" -g "" -u critical
  else
    omarchy notification send "Saved '$name'" "$n window(s) from this workspace" -g "󰆓"
  fi
else
  omarchy notification send "Failed to save '$name'" "$(tail -n1 <<< "$out")" -g "" -u critical
fi
