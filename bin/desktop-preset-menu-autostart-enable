#!/usr/bin/env bash
# desktop-preset-menu-autostart-enable - "Enable on this desktop" action for
# the omarchy.menu Preset -> Autostart submenu
set -uo pipefail

names=$(desktop_preset list --names 2>/dev/null)
if [[ -z $names ]]; then
  omarchy notification send "No desktop presets" "Save one first: desktop_preset save <name>" -g "" -u normal
  exit 0
fi

chosen=$(omarchy menu select "Auto-load at login" $names) || exit 0   # cancelled
[[ -n $chosen ]] || exit 0

ws=$(hyprctl activeworkspace -j | jq -r '.id')
out=$(desktop_preset autostart set "$chosen" -w "$ws" 2>&1)
rc=$?

if (( rc == 0 )); then
  omarchy notification send "Autostart enabled" "workspace $ws -> '$chosen' at login" -g "󰆓"
else
  omarchy notification send "Failed to enable autostart" "$(tail -n1 <<< "$out")" -g "" -u critical
fi
